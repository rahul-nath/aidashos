# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.local_agent/
# Coordination ledger runtime journal (events.jsonl, state.sqlite).
.agent_coordination/
.env
# Every other .env variant is real credentials too: backups taken before a
# risky change, per-machine overrides, whatever someone names it in a hurry.
# `.env` alone matched exactly one filename, so `.env.backup-preE2E-20260805`
# sat untracked-but-stageable, one `git add -A` away from being committed.
# The exceptions mirror `_is_environment_file` in the public snapshot importer,
# so the two places that decide what an environment file is cannot disagree.
.env.*
!.env.example
!.env.sample
!.env.template
# Editors write their backup beside the file with a suffix and no dot, so `.env~`
# matches neither `.env` nor `.env.*`. That is not hypothetical: it is the one
# variant that actually reached a commit, because the pattern above reads as
# covering "every other .env variant" and quietly does not.
.env*~
.pytest_cache/
.ruff_cache/
.DS_Store

# Seed + sync data for the vector store — large and reproducible from exports.
data/
web/test-results/
web/playwright-report/
.claude/worktrees/
# Claude Code runtime artifacts that shouldn't be committed.
.claude/*.lock
.claude/scheduled_tasks.lock
CLAUDE.local.md
*/.DS_Store

# Local microphone session output.
asr-transcript-*.txt
*.txt~
docs/gawd_drafts/

# Handoffs containing client or business-sensitive context stay local-only.
docs/handoffs/local/

# Mirdin course reference texts. Author asks not to share; keep local-only.
docs/reference/

# Host-smoke OCR images are operator-supplied and large; the fixture README
# says which files to drop here. Only the expected-text files are tracked.
tests/fixtures/**/*.png
tests/fixtures/**/*.jpg
tests/fixtures/**/*.jpeg
tests/fixtures/**/*.webp
tests/fixtures/**/*.heic
tests/fixtures/**/*.tif
tests/fixtures/**/*.tiff

# Coverage data is a local measurement, not a checked-in artifact.
.coverage
.coverage.*
htmlcov/
local_first_agent_os.sqlite
