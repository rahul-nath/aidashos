# Refuse to install on a Node older than package.json's `engines` says.
#
# Without this, npm treats `engines` as advice: `npm ci` on Node 16 succeeds,
# resolves the wrong platform-specific binaries for rolldown/vite, and leaves a
# node_modules that fails later with a native-binding error naming a file rather
# than the actual cause. The install is where the mistake is still cheap.
#
# The version to install is pinned in the repo root `.nvmrc`. Run `nvm use` from
# the repository root before installing.
engine-strict=true
