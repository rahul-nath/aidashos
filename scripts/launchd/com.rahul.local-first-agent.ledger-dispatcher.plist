<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The loop that claims dispatch intents and runs them to a terminal outcome.

  The other half of the pair described in the enqueue drainer's plist, and the
  same reasoning applies to every setting below. This one polls faster because
  a milestone is parked waiting on the intent it submitted, so the interval is
  latency a human eventually feels rather than background housekeeping.

  It launches DBOS itself, which is what lets it wake the milestones parked on
  the intents it settles.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rahul.local-first-agent.ledger-dispatcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV_BIN__</string>
    <string>run</string>
    <string>python</string>
    <string>agent_coordination_mcp.py</string>
    <string>--root</string>
    <string>__REPO_ROOT__</string>
    <string>run_ledger_dispatcher</string>
    <string>--interval-seconds</string>
    <string>2</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LOCAL_AGENT_USE_DBOS</key>
    <string>true</string>
    <key>LOCAL_AGENT_DATABASE_URL</key>
    <string>postgresql+psycopg://postgres:postgres@127.0.0.1:5432/local_agent</string>
    <key>LOCAL_AGENT_COORDINATION_BACKEND</key>
    <string>postgres</string>
    <key>LOCAL_AGENT_COORDINATION_DATABASE_URL</key>
    <string>postgresql+psycopg://postgres:postgres@127.0.0.1:5432/local_agent</string>
    <key>LOCAL_AGENT_DBOS_SYSTEM_DATABASE_URL</key>
    <string>postgresql+psycopg://postgres:postgres@127.0.0.1:5432/local_agent_dbos</string>
    <key>DBOS_SYSTEM_DATABASE_URL</key>
    <string>postgresql+psycopg://postgres:postgres@127.0.0.1:5432/local_agent_dbos</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.local-agent/logs/ledger-dispatcher.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local-agent/logs/ledger-dispatcher.err.log</string>
</dict>
</plist>
